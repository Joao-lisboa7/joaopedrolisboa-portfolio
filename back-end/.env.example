# Configuração de exemplo para variáveis de ambiente
# Copie para .env ou configure no seu ambiente de execução / CI/CD

# WakaTime API
WAKATIME_API_KEY=seu_token_aqui_sem_expor_no_git
WAKATIME_API_BASE_URL=https://wakatime.com/api/v1
WAKATIME_CACHE_TTL_MINUTES=30

